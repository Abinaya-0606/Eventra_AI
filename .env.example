# Copy this file to .env and fill in the values.  NEVER commit .env to Git (it is already in .gitignore).

# ---------- required ----------
# Signs login cookies. Use a long random string. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=eventra-super-secret-key-123
# Get a key at https://console.groq.com  (used only on the server, never sent to the browser)
GROQ_API_KEY=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

# ---------- AI models (optional) ----------
GROQ_MODEL=qwen/qwen3.8-27b
# A stronger model for Tamil answers (falls back to GROQ_MODEL when empty)
GROQ_MODEL_TAMIL=qwen/qwen3.8-27b
# LLM_TIMEOUT=45
# Chatbot: chunks farther than this are ignored. Raise it if the bot says "not enough information" too often.
# RAG_MAX_DISTANCE=1.0
# RAG_TOP_K=4

# ---------- app ----------
# development (default) | production
# APP_ENV=development
# Shown on the cover page of generated proposals
# COLLEGE_NAME=Your College Name
# Public address of the site, used in password-reset emails (needed in production), e.g. https://eventra-ai.onrender.com
# APP_BASE_URL=http://localhost:5000

# ---------- storage (optional; defaults are fine locally) ----------
# DATABASE_PATH=instance/eventai.db
# CHROMA_DIR=chroma_db

# ---------- first admin (no default account or password exists) ----------
# Locally:  flask --app run seed-admin   (or: python seed_admin.py)  - reads the three values below.
# Without a terminal (e.g. Render free plan) they are also used once at start-up, only while NO admin exists.
# Remove ADMIN_PASSWORD after the first login at /admin/login. Admin passwords: 10+ characters, a letter and a number.
# ADMIN_EMAIL=you@example.com
# ADMIN_NAME=Your Name
# ADMIN_PASSWORD=a-long-passphrase-with-letters-and-numbers1

# ---------- email for password resets (optional) ----------
# Without SMTP the reset link is printed in the terminal instead of being emailed.
# For Gmail: smtp.gmail.com, port 587 and an App Password (not your normal password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_app_password
# MAIL_FROM=you@gmail.com

# ---------- security tuning (optional) ----------
# MAX_FAILED_LOGINS=5
# LOCKOUT_SECONDS=600
# RESET_TOKEN_MINUTES=30
# Set to 0 if production is NOT behind a proxy such as Render's (otherwise X-Forwarded headers are trusted)
# TRUST_PROXY=1
